rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared exam question bank. Any signed-in user may read it, and may create it once
    // (this is how the app seeds sample content on first run since there is no backend/admin
    // process). Once a document exists it can no longer be modified or deleted by clients,
    // so users cannot vandalize the shared question bank.
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;

      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Per-user exam attempts. Only the owning user can read or write their own attempts.
    match /users/{userId}/examAttempts/{examId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared vocabulary bank, one bucket per device language (e.g. "tr", "es"). Translations
    // are fetched from the free translation API and written once per language; after that every
    // device reads the cached translations instead of re-translating the same words.
    match /words/{langCode}/items/{wordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Master word bank: the single source of truth for which words exist in the app. Clients
    // may only create it once (first-run seed if empty); editing/adding words afterwards is
    // done from the Firebase console, which uses admin access and is not subject to these rules.
    match /word_bank/{wordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Master grammar topic bank, same "seed once, manage from console" pattern as word_bank.
    match /grammar_topics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Per-language cache of translated grammar explanations, same pattern as /words.
    match /grammar_explanations/{langCode}/items/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Per-language cache of translated exam titles, same pattern as /words.
    match /exam_titles/{langCode}/items/{examId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Master reading passage bank, same "seed once, manage from console" pattern as word_bank.
    // Passages are always English, so there is no per-language translation cache to go with it.
    match /reading_passages/{passageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
