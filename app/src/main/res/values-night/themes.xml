<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Same Material3 parent as the light theme (values/themes.xml) so widgets (buttons, cards,
         etc.) get identical default styling in both modes — a MaterialComponents parent here
         previously caused dark-mode-only widget styling drift. -->
    <style name="Theme.GlobalYDS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <!-- Unlike light mode, onPrimary/onSecondary are fixed (not tied to surface colors)
             so text on brand-colored surfaces keeps solid contrast in dark mode. -->
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">#052E16</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>

        <item name="android:fontFamily" tools:targetApi="o">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>
</resources>
