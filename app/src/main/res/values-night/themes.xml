<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GlobalYDS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">#0F172A</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">#052E16</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/backgroundColor</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>

        <!-- Modern Activity Window Animations -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation.Premium</item>

        <!-- App-wide typography -->
        <item name="android:fontFamily" tools:targetApi="o">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>

        <!-- Material 3 BottomNavigationView default styling -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>
</resources>
