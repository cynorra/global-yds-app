<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GlobalYDS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">#052E16</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/backgroundColor</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Premium specific attributes -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>

        <!-- Modern Activity Window Animations -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation.Premium</item>

        <!-- App-wide typography. android:fontFamily applies on API 26+; fontFamily is the
             AppCompat-backported attribute that also covers API 24-25. Falls back to the
             system font automatically if the Google Fonts provider can't be resolved. -->
        <item name="android:fontFamily" tools:targetApi="o">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>

        <!-- Material 3 Typography Attributes -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.Body</item>

        <!-- Material 3 BottomNavigationView default styling -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <!-- Typography appearances -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">@color/textColorSecondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="WindowAnimation.Premium" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/motion_slide_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/motion_slide_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/motion_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/motion_pop_exit</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/App.ItemActiveIndicator</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
        <item name="android:background">@color/cardBackground</item>
    </style>

    <style name="App.ItemActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/circleIconBg</item>
        <item name="android:width">52dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- Splash screen shown while OnboardingActivity decides where to route the user
         (already-logged-in / onboarded / first-run). See androidx.core:core-splashscreen. -->
    <style name="Theme.GlobalYDS.Splash" parent="Theme.GlobalYDS">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
