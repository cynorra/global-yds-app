<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <ImageView
        android:id="@+id/ivHeaderIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:background="@drawable/bg_icon_circle"
        android:src="@drawable/ic_module_vocabulary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/vocab_learn"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        app:layout_constraintTop_toTopOf="@id/ivHeaderIcon"
        app:layout_constraintStart_toEndOf="@id/ivHeaderIcon"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="@string/vocab_desc"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toEndOf="@id/ivHeaderIcon"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Global Exam Filter Chips -->
    <HorizontalScrollView
        android:id="@+id/scrollVocabFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupVocabFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🌍 Tümü" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabToeic"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇯🇵 TOEIC" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabIelts"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇬🇧 IELTS" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabToefl"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇺🇸 TOEFL" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabCambridge"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇪🇺 Cambridge" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabSat"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓 SAT / ACT" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabPte"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇦🇺 PTE" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabDet"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦉 DET" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabEiken"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌸 EIKEN" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabGre"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 GRE / GMAT" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVocabYds"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇹🇷 YDS / YÖKDİL" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <io.supercharge.shimmerlayout.ShimmerLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/scrollVocabFilter"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="150dp" android:background="@color/dividerColor" android:layout_margin="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="150dp" android:background="@color/dividerColor" android:layout_margin="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="150dp" android:background="@color/dividerColor" android:layout_margin="16dp"/>
        </LinearLayout>
    </io.supercharge.shimmerlayout.ShimmerLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVocabulary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:layoutAnimation="@anim/layout_animation_fall_down"
        app:layout_constraintTop_toBottomOf="@id/scrollVocabFilter"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        android:id="@+id/emptyStateRoot"
        layout="@layout/layout_empty_state"
        app:layout_constraintTop_toBottomOf="@id/scrollVocabFilter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
