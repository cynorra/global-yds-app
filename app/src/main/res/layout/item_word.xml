<?xml version="1.0" encoding="utf-8"?>
<com.chauthai.swipereveallayout.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRevealLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:dragEdge="right"
    app:mode="same_level">

    <!-- BOTTOM LAYER (Behind the card when swiped) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnLearned"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="#10B981"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                app:tint="@android:color/white" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDelete"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="#EF4444"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@android:color/white" />
        </FrameLayout>

    </LinearLayout>

    <!-- TOP LAYER (The main vocabulary card) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/dividerColor"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/cardBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Type Icon/Badge -->
            <ImageView
                android:id="@+id/ivTypeIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_module_vocabulary"
                app:tint="@color/colorPrimary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvEnglishWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp"
                tools:text="Acquisition"
                android:textColor="@color/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnSpeaker"
                app:layout_constraintStart_toEndOf="@id/ivTypeIcon"
                app:layout_constraintTop_toTopOf="@id/ivTypeIcon"
                app:layout_constraintBottom_toBottomOf="@id/ivTypeIcon"/>

            <ImageView
                android:id="@+id/btnSpeaker"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_speaker"
                app:tint="@color/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Listen"
                app:layout_constraintEnd_toStartOf="@id/tvTargetExamBadge"
                app:layout_constraintTop_toTopOf="@id/ivTypeIcon"
                app:layout_constraintBottom_toBottomOf="@id/ivTypeIcon"/>

            <TextView
                android:id="@+id/tvTargetExamBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_exam_type"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivTypeIcon"
                app:layout_constraintBottom_toBottomOf="@id/ivTypeIcon"
                tools:text="🇯🇵 TOEIC" />

            <TextView
                android:id="@+id/tvTurkishMeaning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                tools:text="Şirket devralma / Satın alma"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivTypeIcon" />

            <!-- Example sentence bubble container -->
            <LinearLayout
                android:id="@+id/layoutExampleBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_example_bubble"
                android:padding="14dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvTurkishMeaning"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvExample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="The company announced the acquisition of its primary domestic rival."
                    android:textColor="@color/textColorSecondary"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCardActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/layoutExampleBubble"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/btnQuickLearned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_success"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="✓ Öğrendim"
                    android:textColor="@color/colorOnSuccess"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvSwipeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Sola kaydır: Sil"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</com.chauthai.swipereveallayout.SwipeRevealLayout>
