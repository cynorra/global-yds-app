<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/emptyStateRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingVertical="40dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/ivEmptyStateIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.6"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="@color/textColorSecondary"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvEmptyStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/textColorPrimary"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Henüz içerik yok" />

    <TextView
        android:id="@+id/tvEmptyStateSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp"
        tools:text="Daha sonra tekrar kontrol edin." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyStateRetry"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_retry"
        android:visibility="gone" />

</LinearLayout>
